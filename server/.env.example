# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database ----
# Local helper cluster (see README "Local database"): postgresql://chessarena@localhost:5433/chessarena
# Managed providers usually require ?sslmode=require
DATABASE_URL=postgresql://chessarena@localhost:5433/chessarena?schema=public
# Used only by the automated test suite (it is wiped by tests!)
TEST_DATABASE_URL=postgresql://chessarena@localhost:5433/chessarena_test?schema=public

# ---- Origins ----
# Comma-separated list of allowed browser origins (CORS + Socket.IO Origin check)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend, used in password-reset links
APP_URL=http://localhost:5173

# ---- Auth secrets ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_SOCKET_SECRET=change-me-socket-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# lax (recommended: same-site deployment via Vercel rewrite) | strict | none
COOKIE_SAMESITE=lax
# Leave empty unless the API must set cookies for a parent domain
COOKIE_DOMAIN=
# Number of reverse proxies in front of the app (Render = 1). Needed for correct client IPs / rate limits.
TRUST_PROXY=0

# ---- Gameplay ----
RECONNECT_GRACE_MS=60000
INVITATION_TTL_MINUTES=60

# ---- Email: password resets (optional). Without a provider, reset links are only logged in development. ----
# Sender shown to recipients:
MAIL_FROM=ISTA ChessArena <rangasamymeena945@gmail.com>
# Option A - Gmail SMTP (works on your PC and on paid hosting). SMTP_PASS must be a Gmail App Password
# (Google Account > Security > 2-Step Verification > App passwords), never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rangasamymeena945@gmail.com
SMTP_PASS=
# Option B - Brevo HTTPS API (works on Render free plan, which blocks SMTP). Used instead of SMTP when set.
BREVO_API_KEY=
# Require new players to confirm their email before signing in (true/false).
REQUIRE_EMAIL_VERIFICATION=false

# ---- First admin bootstrap (used only by `npm run admin:create`) ----
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
